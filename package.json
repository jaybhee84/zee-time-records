{
  "name": "zee-time-records-app",
  "version": "2.0.7",
  "description": "DTR generator that imports ZKTeco USB flash-disk attendance dumps and produces CSC Form 48 style Daily Time Records.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "mdb": "^0.1.0",
    "pdf-to-printer": "^5.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.jaybhee.zkteco-dtr",
    "productName": "DepEd DTR Generator",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/icon.ico"
    ],
    "asarUnpack": [
      "**/node_modules/pdf-to-printer/**/*",
      "**/node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
   "nsis": {
  "oneClick": false,
  "allowToChangeInstallationDirectory": true,
  "createDesktopShortcut": true,
  "createStartMenuShortcut": true,
  "shortcutName": "DepEd DTR Generator",
  "perMachine": true,
  "runAfterFinish": true,
  "allowElevation": true
}
  }
}
